# =============================================================================
# Obsidian Panel — Environment Variables (copy to .env and fill)
# =============================================================================
#  cp .env.example .env   # then edit values
#
# Backend runs on :8080, Frontend dev server on :5173 (proxies /api + /ws → :8080)

# --- PostgreSQL --------------------------------------------------------------
DB_PASSWORD=change_me

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=change-me-to-a-real-secret-in-production-at-least-256-bits-long

# --- Docker Engine -----------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SERVERS_PATH=/tmp/panel/servers

# --- Frontend (Vite) ---------------------------------------------------------
# Only needed if backend isn't on localhost:8080
# VITE_API_BASE_URL=http://localhost:8080
